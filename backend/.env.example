# Скопируйте в backend/.env и заполните. Файл .env НЕ коммитится (см. .gitignore).

# ── Gemini (планирование монтажа) ──────────────────────────────────────────
GEMINI_API_KEY=
ALLOWED_ORIGIN=https://murbellka.github.io
# GEMINI_MODEL=gemini-2.5-flash
# PORT=8080

# ── Рендер ─────────────────────────────────────────────────────────────────
# Заданы RENDER_BUCKET и RENDER_JOB_NAME → режим cloud (Firestore + GCS +
# Cloud Run Job). Не заданы → режим local: состояние в памяти, файлы в
# LOCAL_RENDER_ROOT. См. docs/render-contract.md §10.
# RENDER_BUCKET=reelio-render-eu
# RENDER_JOB_NAME=reelio-ffmpeg-worker
# RENDER_JOB_REGION=europe-west1
# GOOGLE_CLOUD_PROJECT=
# FIRESTORE_DATABASE=(default)

# Публичный адрес сервиса — нужен worker'у для отчётов о прогрессе (§8.1).
# PUBLIC_BASE_URL=https://reelio-backend-xxxx.run.app

# Общий секрет worker → backend. В облаке — через Secret Manager, НЕ в коде.
# Если не задан, генерируется на старте (годится только для local).
# WORKER_TOKEN=

# ── Локальный режим (e2e без платных ресурсов) ─────────────────────────────
# LOCAL_RENDER_ROOT=.render-local
# LOCAL_WORKER_CMD=node ../worker/index.js

# ── Тонкая настройка ───────────────────────────────────────────────────────
# SIGNED_URL_TTL_SECONDS=3600
# JOB_TTL_DAYS=7
# WORKER_HEARTBEAT_TIMEOUT_SECONDS=600
# RATE_LIMIT_EDIT_PLAN=20
# RATE_LIMIT_RENDER=10
# RATE_LIMIT_POLL=240
