# Пример переменных окружения. Реальный .env НЕ коммитится (см. .gitignore).
#
# Ключ Gemini используется ТОЛЬКО backend'ом (папка backend/), никогда —
# Flutter/Web-клиентом и никогда не попадает в GitHub Pages.
GEMINI_API_KEY=
ALLOWED_ORIGIN=https://murbellka.github.io

# Адрес backend'а для клиента (передаётся в сборку через --dart-define,
# это НЕ секрет):
# REELIO_BACKEND_URL=https://your-backend.example.com
